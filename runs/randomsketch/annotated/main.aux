\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Empirical MSE ratio of the corrected to the complementary risk estimator for weighted Haar sketches under Gaussian data. Rows give $d/n\in \{0.30,0.50,0.70\}$ and columns give $n\in \{100,300,500\}$; the horizontal axis is the actual $m/n$. Points and error bars show ratios and pointwise $95\%$ paired Monte Carlo intervals based on 1,000 repetitions per setting. Ratios above one favor the complementary estimate; ratios below one favor the corrected estimate. The horizontal line marks equal MSE, and connecting segments only guide the eye. Only empirical ratios are shown because the scaled orthogonal formula does not apply to the alternating weights.}}{20}{figure.5}\protected@file@percent }
\newlabel{fig:simulation-mse-weighted-haar}{{5}{20}{Empirical MSE ratio of the corrected to the complementary risk estimator for weighted Haar sketches under Gaussian data. Rows give $d/n\in \{0.30,0.50,0.70\}$ and columns give $n\in \{100,300,500\}$; the horizontal axis is the actual $m/n$. Points and error bars show ratios and pointwise $95\%$ paired Monte Carlo intervals based on 1,000 repetitions per setting. Ratios above one favor the complementary estimate; ratios below one favor the corrected estimate. The horizontal line marks equal MSE, and connecting segments only guide the eye. Only empirical ratios are shown because the scaled orthogonal formula does not apply to the alternating weights}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Empirical MSE ratio of the corrected to the complementary risk estimator for raw dense Gaussian sketches under Gaussian data. Layout, dimensions, pairing, repetitions, and intervals match Figure~\ref {fig:simulation-mse-weighted-haar}. Ratios above one favor the complementary estimate; ratios below one favor the corrected estimate. The horizontal line marks equal MSE, and connecting segments only guide the eye. Only empirical ratios are shown because a dense Gaussian sketch is not a scaled orthogonal sketch.}}{21}{figure.6}\protected@file@percent }
\newlabel{fig:simulation-mse-dense-gaussian}{{6}{21}{Empirical MSE ratio of the corrected to the complementary risk estimator for raw dense Gaussian sketches under Gaussian data. Layout, dimensions, pairing, repetitions, and intervals match Figure~\ref {fig:simulation-mse-weighted-haar}. Ratios above one favor the complementary estimate; ratios below one favor the corrected estimate. The horizontal line marks equal MSE, and connecting segments only guide the eye. Only empirical ratios are shown because a dense Gaussian sketch is not a scaled orthogonal sketch}{figure.6}{}}
