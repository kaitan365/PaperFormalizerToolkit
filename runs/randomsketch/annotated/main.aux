\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean prediction risks and risk estimates under independent uniform errors on $[-1,1]$, with variance $1/3$. Layout, sample sizes, pairing, and Monte Carlo intervals match Figure~\ref {fig:simulation-noninterpolating-accuracy}. Because the errors are uniform, the complementary-risk curves provide empirical calibration rather than an application of the Gaussian chi-square law. The $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_B$ curve uses Bellec's formula for all three sketch families. The complementary estimate is undefined when $m=n$.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:simulation-noninterpolating-risk-uniform}{{4}{16}{Mean prediction risks and risk estimates under independent uniform errors on $[-1,1]$, with variance $1/3$. Layout, sample sizes, pairing, and Monte Carlo intervals match Figure~\ref {fig:simulation-noninterpolating-accuracy}. Because the errors are uniform, the complementary-risk curves provide empirical calibration rather than an application of the Gaussian chi-square law. The $\widehat R_B$ curve uses Bellec's formula for all three sketch families. The complementary estimate is undefined when $m=n$}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean prediction risks and risk estimates at $n=1000$, based on 1,000 independent repetitions per setting. Parentheses contain Monte Carlo standard errors. The Bellec column uses the same formula, denoted $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_B$, for all three sketch families. WH and DG denote weighted Haar and dense Gaussian sketches; G and U denote Gaussian and uniform errors. A dash denotes the undefined complementary estimate when $m=n$.}}{17}{table.1}\protected@file@percent }
\newlabel{tab:simulation-noninterpolating}{{1}{17}{Mean prediction risks and risk estimates at $n=1000$, based on 1,000 independent repetitions per setting. Parentheses contain Monte Carlo standard errors. The Bellec column uses the same formula, denoted $\widehat R_B$, for all three sketch families. WH and DG denote weighted Haar and dense Gaussian sketches; G and U denote Gaussian and uniform errors. A dash denotes the undefined complementary estimate when $m=n$}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired empirical bias at $n=1000$ in the expanded risk-curve study, with 1,000 repetitions per setting. Parentheses contain Monte Carlo standard errors of the empirical mean biases. Dashes have the same meaning as in Table~\ref {tab:simulation-noninterpolating}, as do WH, DG, G, and U.}}{18}{table.2}\protected@file@percent }
\newlabel{tab:appendix-accuracy-bias}{{2}{18}{Paired empirical bias at $n=1000$ in the expanded risk-curve study, with 1,000 repetitions per setting. Parentheses contain Monte Carlo standard errors of the empirical mean biases. Dashes have the same meaning as in Table~\ref {tab:simulation-noninterpolating}, as do WH, DG, G, and U}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Empirical RMSE at $n=1000$ in the expanded risk-curve study, with 1,000 repetitions per setting. Parentheses contain delta-method Monte Carlo standard errors. Dashes have the same meaning as in Table~\ref {tab:simulation-noninterpolating}, as do WH, DG, G, and U.}}{18}{table.3}\protected@file@percent }
\newlabel{tab:appendix-accuracy-rmse}{{3}{18}{Empirical RMSE at $n=1000$ in the expanded risk-curve study, with 1,000 repetitions per setting. Parentheses contain delta-method Monte Carlo standard errors. Dashes have the same meaning as in Table~\ref {tab:simulation-noninterpolating}, as do WH, DG, G, and U}{table.3}{}}
