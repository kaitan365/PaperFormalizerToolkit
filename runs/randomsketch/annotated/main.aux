\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Conditional calibration of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_c$ at $n=300$ and $m=150$ ($q=n-m$). Panels show the mean of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_c/R$, its conditional sample variance divided by $2/q$, and coverage of the nominal $95\%$ risk interval. Each setting uses 100 fixed fits and 1,000 complementary draws per fit. Error bars are pointwise $95\%$ intervals across fits.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:simulation-conditional}{{1}{11}{Conditional calibration of $\widehat R_c$ at $n=300$ and $m=150$ ($q=n-m$). Panels show the mean of $\widehat R_c/R$, its conditional sample variance divided by $2/q$, and coverage of the nominal $95\%$ risk interval. Each setting uses 100 fixed fits and 1,000 complementary draws per fit. Error bars are pointwise $95\%$ intervals across fits}{figure.1}{}}
