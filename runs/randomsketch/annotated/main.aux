\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean prediction risks and estimates under Gaussian errors. Rows give the three sketch families and columns give $(d/n,m/n)$; each point uses 1,000 repetitions. The black curve is mean true risk, and bands are pointwise $95\%$ Monte Carlo intervals $\bar  T\pm 1.96s(T)/\sqrt  {1000}$ for each plotted mean. Bellec's formula is applied to every sketch family as an empirical comparison. When $m=n$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_c$ is undefined; the observable, GCV, and Bellec curves coincide for row sampling, and Bellec's curve coincides with GCV for the other sketches. Both axes are linear.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:simulation-noninterpolating-accuracy}{{2}{12}{Mean prediction risks and estimates under Gaussian errors. Rows give the three sketch families and columns give $(d/n,m/n)$; each point uses 1,000 repetitions. The black curve is mean true risk, and bands are pointwise $95\%$ Monte Carlo intervals $\bar T\pm 1.96s(T)/\sqrt {1000}$ for each plotted mean. Bellec's formula is applied to every sketch family as an empirical comparison. When $m=n$, $\widehat R_c$ is undefined; the observable, GCV, and Bellec curves coincide for row sampling, and Bellec's curve coincides with GCV for the other sketches. Both axes are linear}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces MSE ratio of $\hat  {R}_o$ to $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_c$ under Gaussian data and row sampling. Rows give $d/n$, columns give $n$, and the horizontal axis gives rounded $m/n$. Points and pointwise $95\%$ paired intervals use 1,000 repetitions. The green curve is exact; dashed and dotted lines mark $\rho _*(\gamma )$ and $\rho _n^{\#}$. Values above one favor $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle R$}\mathaccent "0362{R}_c$.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:simulation-mse-threshold}{{3}{13}{MSE ratio of $\hR _o$ to $\widehat R_c$ under Gaussian data and row sampling. Rows give $d/n$, columns give $n$, and the horizontal axis gives rounded $m/n$. Points and pointwise $95\%$ paired intervals use 1,000 repetitions. The green curve is exact; dashed and dotted lines mark $\rho _*(\gamma )$ and $\rho _n^{\#}$. Values above one favor $\widehat R_c$}{figure.3}{}}
